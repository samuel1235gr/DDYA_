

def primo(n):
  if n <= 1:
    return False
  for i in range(2, n):
    if n % i == 0:
      return False
  return True


def intermedios(a, b):
  suma = 0
  if a > b:
    inicio = b
    fin = a
  else:
    inicio = a
    fin = b

  for i in range(inicio + 1, fin):
    suma += i
  return suma


def elevar(n):
  if n % 2 == 0:
    return n * n * n
  else:
    return n * n


